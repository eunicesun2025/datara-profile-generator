# Copy this file to .env and fill values once. .env is ignored by Git.
# Existing operating-system/container environment variables take precedence.
DATARA_DATA_DIR=./data
DATARA_API_KEY=
# DEBUG | INFO | WARNING | ERROR | CRITICAL. Keep WARNING for normal use.
# Set INFO when diagnosing model calls: it enables the model_request_started /
# model_request_finished timings that separate a slow model from a stalled proxy.
# uvicorn --log-level does NOT work for this; it only affects uvicorn's own loggers.
DATARA_LOG_LEVEL=WARNING
